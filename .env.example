# ---------------------------------------------------------------------------
# Kynox Supply Chain Intelligence — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV=production
PORT=4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=https://analytics.kynox.io

# --- Security ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Database ---
# DB_CLIENT: better-sqlite3 (local dev only) | pg (preferred) | mysql2 (Hostinger fallback)
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kynox_analytics
DB_USER=
DB_PASSWORD=
# For pg over TLS set DB_SSL=true
DB_SSL=false
# Only for better-sqlite3:
# DB_FILE=./database/kynox.sqlite

# --- Initial administrator (used by the seed once; change the password after first login) ---
ADMIN_EMAIL=admin@kynox.io
ADMIN_INITIAL_PASSWORD=

# --- File handling ---
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_MB=50
# Retention for the daily cleanup job (uploads referenced by datasets are never deleted)
UPLOAD_RETENTION_DAYS=90
EXPORT_RETENTION_DAYS=14

# --- AI (optional; the platform runs fully without it) ---
# AI_PROVIDER: anthropic | openai | none
AI_PROVIDER=none
# AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional custom gateway (Azure-hosted or local models)
# AI_BASE_URL=

# --- Logging ---
LOG_LEVEL=info
