# ---------------------------------------------------------------------------
# Kynox Supply Chain Intelligence — STAGING environment template
# Copy to /home/<user>/domains/staging-analytics.kynox.io/shared/.env
# and fill in real values. NEVER commit the real file.
#
# Staging runs with NODE_ENV=production so all production safety checks
# (startup validation, secure defaults) are active; APP_ENV distinguishes
# the environment for logs, monitoring and scripts.
# ---------------------------------------------------------------------------

NODE_ENV=production
APP_ENV=staging
PORT=4100
APP_URL=https://staging-analytics.kynox.io
CORS_ORIGIN=https://staging-analytics.kynox.io

# --- Security ---
# REQUIRED, >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Database (dedicated staging DB + least-privilege user; NEVER the WMS or
#     production database) ---
# PostgreSQL preferred on VPS; mysql2 only when Postgres is unavailable.
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kynox_staging
DB_USER=kynox_staging_app
DB_PASSWORD=
DB_SSL=false

# --- Initial staging administrator (used once by the seed; rotate after first login) ---
ADMIN_EMAIL=staging-admin@kynox.io
ADMIN_INITIAL_PASSWORD=

# --- File handling (dedicated staging directories under shared/) ---
UPLOAD_DIR=/home/CHANGE_ME/domains/staging-analytics.kynox.io/shared/uploads
EXPORT_DIR=/home/CHANGE_ME/domains/staging-analytics.kynox.io/shared/exports
MAX_UPLOAD_MB=50
UPLOAD_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=7

# --- Logging ---
LOG_LEVEL=info
# pm2 writes stdout/stderr to shared/logs/ (see ecosystem.config.cjs)

# --- AI (staging only enables AI when the staging owner sets these) ---
# Leave AI_PROVIDER=none until the data-governance review in
# docs/AI_GOVERNANCE.md has been signed off for the chosen provider.
AI_PROVIDER=none
# AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI_BASE_URL=

# --- AI runtime limits (enforced server-side; tune per staging policy) ---
AI_MAX_PROMPT_CHARS=2000
AI_MAX_EVIDENCE_RECORDS=40
AI_MAX_RESPONSE_TOKENS=4096
AI_TIMEOUT_MS=60000
AI_RETRY_COUNT=1
AI_USER_DAILY_LIMIT=50
AI_ORG_DAILY_LIMIT=500
AI_ORG_DAILY_TOKEN_LIMIT=2000000
